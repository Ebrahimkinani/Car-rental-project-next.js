# Mock data mode (default: on — app runs without MongoDB for UI preview)
# Set to false when reconnecting the database
NEXT_PUBLIC_USE_MOCK_DATA=true

# MongoDB (optional while mock mode is enabled)
# MONGODB_URI=mongodb://localhost:27017/car_rental
# MONGODB_DB=car_rental

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=RentCar

# Auth (required — use a strong random value in production)
JWT_SECRET=your-secret-key-here

# Demo logins when NEXT_PUBLIC_USE_MOCK_DATA=true (see src/data/mock-users.ts):
# admin@demo.com / demo12345  |  customer@demo.com / demo12345
